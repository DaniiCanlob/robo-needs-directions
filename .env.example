# Port the server listens on
PORT=3000
# Where scores.json lives (use a mounted volume in Docker)
DATA_DIR=./data
# "*" or a comma-separated list of allowed origins
CORS_ORIGIN=*
# Set a value to require "Authorization: Bearer <token>" on DELETE /api/scores
ADMIN_TOKEN=
# Per-IP write throttle
RATE_WINDOW_MS=60000
RATE_MAX_WRITES=30
